{
  "name": "@linked.cm/access",
  "description": "Access contracts for LINKED apps: ODRL-based grants, selectors and conditions, a portable authorization evaluator, and a Linked Query policy repository.",
  "license": "MIT",
  "version": "0.1.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linked-cm/access.git"
  },
  "type": "module",
  "packageManager": "npm@11.20.0",
  "linkedPackage": true,
  "main": "lib/esm/index.js",
  "exports": {
    ".": {
      "types": "./lib/esm/index.d.ts",
      "development": "./src/index.ts",
      "import": "./lib/esm/index.js"
    },
    "./*": {
      "types": "./lib/esm/*.d.ts",
      "development": "./src/*.ts",
      "import": "./lib/esm/*.js"
    }
  },
  "scripts": {
    "build": "npm exec linked build",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.cjs"
  },
  "dependencies": {
    "@_linked/core": "^2.17.0",
    "@_linked/server-utils": "^1.1.0"
  },
  "devDependencies": {
    "@_linked/cli": "^1.11.1",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.14",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "5.7.3"
  },
  "files": [
    "lib",
    "src",
    "!src/**/*.test.ts",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
