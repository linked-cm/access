    },
    "./*": {
      "types": "./lib/esm/*.d.ts",
      "development": "./src/*.ts",
      "import": "./lib/esm/*.js"
    }
  },
  "scripts": {
    "build": "npm exec linked build",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.cjs"
  },
  "dependencies": {
    "@_linked/core": "^2.16.0",
    "@_linked/server-utils": "^1.1.0"
  },
  "devDependencies": {
    "@_linked/cli": "^1.11.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.14",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "5.7.3"
  }
}
