{
  "name": "@_linked/access",
  "description": "Create Now access contracts — ODRL-based grants, selectors, conditions, and the portable authorization evaluation interface (plan-029 T7).",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "linkedPackage": true,
  "main": "lib/esm/index.js",
  "exports": {
    ".": {
      "types": "./lib/esm/index.d.ts",
